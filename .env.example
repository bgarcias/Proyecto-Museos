# Origen de datos: memoria por ahora, prisma cuando se conecte la base de datos. Pública, sin riesgo.
DATA_SOURCE=
# Conexión con pool (parámetro pgbouncer=true) para la aplicación. Secreta.
DATABASE_URL=
# Conexión directa o session pooler, solo para migraciones. Si falta alguna de las dos conexiones, las migraciones fallan. Secreta.
DIRECT_URL=
# URL del proyecto de Supabase. Pública.
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima de Supabase. Pública.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio de Supabase. Secreta: solo se usa en el servidor, para crear usuarios y subir imágenes. Nunca en componentes de cliente.
SUPABASE_SERVICE_ROLE_KEY=
