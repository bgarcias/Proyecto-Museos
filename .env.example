# Origen de datos: prisma (la base real, por defecto) o memoria. Pública, sin riesgo.
DATA_SOURCE=
# Conexión con pool que usa la aplicación en producción (en Supabase, la del pooler en modo transacción). Secreta.
DATABASE_URL=
# Conexión directa (o session pooler) que leen las herramientas de Prisma, como generar y validar el esquema. Secreta.
DIRECT_URL=
# URL del proyecto de Supabase. Pública.
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima de Supabase. Pública.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio de Supabase. Secreta: solo se usa en el servidor, para crear usuarios y subir imágenes. Nunca en componentes de cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Correo del administrador de la carga inicial. Secreto: solo en .env.local.
CARGA_ADMIN_EMAIL=
# Correo del colaborador de la carga inicial. Secreto: solo en .env.local.
CARGA_COLABORADOR_EMAIL=
# Contraseña de las seis cuentas de la carga inicial, con las reglas de longitud de la aplicación. Secreta: solo en .env.local.
CARGA_CONTRASENA=
# Con el valor true, el inicio de sesión muestra las cuentas de demostración (usa los correos y la contraseña de CARGA_). Solo en servidor.
MOSTRAR_DATOS_DEMO=
